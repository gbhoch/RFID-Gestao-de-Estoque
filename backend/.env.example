NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgr3s
DB_NAME=rfid_assets
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d
MAX_LOGIN_ATTEMPTS=5

# Integração do leitor RFID (reader-bridge). Se vazio, as operações físicas
# retornam 503 "aguardando leitor". Aponte para o agente que roda no Windows.
READER_BRIDGE_URL=
READER_BRIDGE_TIMEOUT=15000

# ERP Oracle — acesso SOMENTE LEITURA (usuário só com SELECT). Driver oracledb
# em modo Thin: sem Instant Client, exige Oracle 12.1+. Teste em
# GET /api/v1/erp/test-connection. No Docker, defina no .env da RAIZ do projeto
# (o docker-compose repassa ao backend). Nunca commitar valores reais.
ERP_ORACLE_HOST=
ERP_ORACLE_PORT=1521
ERP_ORACLE_SERVICE=
ERP_ORACLE_USER=
ERP_ORACLE_PASSWORD=
