# Porta HTTP do bridge (o backend aponta READER_BRIDGE_URL para cá).
PORT=8720

# true (padrão): responde dados de exemplo, sem tocar no hardware.
# false: usa as DLLs reais (valide as assinaturas antes — ver README).
SIMULATE=true

# Trava de segurança: só permite write/lock no modo real quando true.
ALLOW_WRITE=false

# Transporte do leitor: net (TCP) | com (serial) | hid (USB).
TRANSPORT=net

# Convenção de chamada das DLLs (stdcall p/ 32-bit; cdecl se necessário).
CALL_CONV=stdcall

# Pasta com CFNetApi.dll / CFComApi.dll / CFHidApi.dll nesta máquina.
DLL_DIR=C:\\CFUHFReaderV4.0

# --- Rede (TRANSPORT=net) ---
READER_IP=192.168.1.250
READER_PORT=60000

# --- Serial (TRANSPORT=com) ---
READER_COM=COM3
READER_BAUD=115200

# Endereço do leitor (0xFF = broadcast).
READER_ADDR=255
